# ========================================================
# AI Cover Letter Generator - Environment Configuration
# ========================================================
# ⚠️ SECURITY NOTICE:
# DO NOT put your real API key in this example file.
# Copy this file to '.env' (which is git-ignored) and add your actual key.
#
# Get your free Gemini API key from:
# https://aistudio.google.com/app/apikey
# ========================================================

# Google Gemini API Key (Vite requires VITE_ prefix for client-exposed variables)
VITE_GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: Alternative naming accepted by the app
VITE_API_KEY=your_google_gemini_api_key_here
